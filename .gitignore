# R and RStudio session files
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
Rplots.pdf

# Credentials never enter git
.Renviron
.env

# Python caches from the render hooks
__pycache__/
.venv/

# macOS and the exFAT drive's AppleDouble sidecars
.DS_Store
._*

# Claude Code local state, private notes and the task folder. This repository is
# public, so project memory, session notes and correspondence stay on this machine.
**/.claude/
CLAUDE.md
INDEX.md
DECISIONS.md
05.tasks/

# Quarto and knitr intermediates, all regenerated by a render. The knitr cache can
# pass GitHub's 100 MB file limit on its own.
.quarto/
_freeze/
01.manuscript/*_files/
01.manuscript/*_cache/
01.manuscript/*.rmarkdown
01.manuscript/*.knit.md
01.manuscript/Manuscript.md
01.manuscript/~$*

# Saved literature. Copyrighted PDFs stay out of git; references.bib records each one.
04.references/literature/

# Raw third-party data. Each source is named, linked and dated in 02.inputs/README.md
# and in the comment above the manuscript line that reads it. Derived tables and figures
# in 03.outputs/ are committed because they are what the manuscript reports.
02.inputs/**/raw/
*.zip
*.tif
*.tiff
*.nc
*.gpkg
*.gdb/

/.quarto/
